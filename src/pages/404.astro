---
import Layout from '../layouts/Layout.astro';
import profile from '../../data/profile.json';

const backArrowPath = 'M15 10 H5 M10 5 L5 10 L10 15';
---

<Layout
  title={`Page not found — ${profile.name}`}
  description="This page doesn't exist."
>
  <main id="content" class="archive-main">
    <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`} class="back-link">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d={backArrowPath}
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      {profile.name}
    </a>
    <h1 class="archive-title">Page not found</h1>
    <p class="notfound-desc">
      The page you're looking for doesn't exist or was moved.
    </p>
      <a class="more-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`}>
      <span>Back to home</span>
    </a>
  </main>
</Layout>
