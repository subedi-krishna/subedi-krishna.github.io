---
import Layout from '../layouts/Layout.astro';
import Sidebar from '../components/Sidebar.astro';
import About from '../components/About.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Research from '../components/Research.astro';
import Skills from '../components/Skills.astro';
import Contact from '../components/Contact.astro';

// Soft delete for Skills: flip this one variable to true and the section
// AND its nav link come back together. Nothing is deleted — Skills.astro
// and data/skills.json stay untouched in the repo.
const SHOW_SKILLS = false;
---

<Layout>
  <Sidebar showSkills={SHOW_SKILLS} />
  <main id="content" class="content">
    <About />
    <Experience />
    <Projects />
    <Research />
    {SHOW_SKILLS && <Skills />}
    <Contact />
  </main>
</Layout>
