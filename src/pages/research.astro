---
import Layout from '../layouts/Layout.astro';
import FilterBar from '../components/FilterBar.astro';
import research from '../../data/research.json';
import profile from '../../data/profile.json';

const sorted = [...research].sort((a, b) => Number(b.year) - Number(a.year));

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const tagStats = new Map<string, { label: string; count: number }>();
for (const paper of research) {
  for (const tag of paper.tags) {
    const value = slugify(tag);
    const stat = tagStats.get(value) ?? { label: tag, count: 0 };
    stat.count += 1;
    tagStats.set(value, stat);
  }
}
const tagOptions = [...tagStats.entries()]
  .map(([value, stat]) => ({ value, ...stat }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const externalIconPath = 'M4 16 L16 4 M8 4 H16 V12';
const backArrowPath = 'M17 10H4M9 5l-5 5 5 5';
---

<Layout
  title={`Research Archive — ${profile.name}`}
  description="Every paper and study I've published, in one place."
>
  <main id="content" class="archive-main" data-filter-scope>
    <a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/`} class="back-link">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d={backArrowPath}
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      {profile.name}
    </a>
    <h1 class="archive-title">All Research</h1>
    <FilterBar
      label="Filter research by topic"
      param="tag"
      options={tagOptions}
      total={research.length}
      itemLabel="papers"
    />
    <div class="table-scroll">
      <table class="archive-table">
        <caption class="sr-only">Complete archive of all research</caption>
        <thead>
          <tr>
            <th scope="col">Year</th>
            <th scope="col">Title</th>
            <th scope="col" class="col-hide-sm">Venue</th>
            <th scope="col" class="col-hide-md">Topics</th>
            <th scope="col">Link</th>
          </tr>
        </thead>
        <tbody>
          {
            sorted.map((paper) => (
              <tr data-filter-target data-filter-value={paper.tags.map(slugify).join(' ')}>
                <td class="t-year">{paper.year}</td>
                <th scope="row" class="t-project">
                  {paper.title}
                </th>
                <td class="col-hide-sm t-madeat">{paper.venue}</td>
                <td class="col-hide-md">
                  <ul class="pills pills--table" aria-label={`Topics of ${paper.title}`}>
                    {paper.tags.map((t) => (
                      <li>
                        <span class="pill">{t}</span>
                      </li>
                    ))}
                  </ul>
                </td>
                <td class="t-link">
                  {paper.venueUrl === '#' ? (
                    <span class="t-empty">
                      <span aria-hidden="true">—</span>
                      <span class="sr-only">No link available</span>
                    </span>
                  ) : (
                    <a
                      href={paper.venueUrl}
                      target="_blank"
                      rel="noreferrer noopener"
                      aria-label={`${paper.title} (opens in a new tab)`}
                    >
                      <svg class="ext-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d={externalIconPath} />
                      </svg>
                    </a>
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </main>
</Layout>
