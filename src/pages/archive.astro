---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import FilterBar from '../components/FilterBar.astro';
import ProjectLinkIcons from '../components/ProjectLinkIcons.astro';
import projects from '../../data/projects.json';
import { availableLinks, validateProjects } from '../lib/project-links';

// Fail the build on bad link data (duplicate slugs, dangling primaryLink, bad video URLs).
validateProjects(projects);

const sorted = [...projects].sort((a, b) => Number(b.year) - Number(a.year));

const slugify = (s: string) =>
  s
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/^-+|-+$/g, '');

const domainStats = new Map<string, { label: string; count: number }>();
for (const project of projects) {
  for (const domain of project.domains) {
    const value = slugify(domain);
    const stat = domainStats.get(value) ?? { label: domain, count: 0 };
    stat.count += 1;
    domainStats.set(value, stat);
  }
}
const domainOptions = [...domainStats.entries()]
  .map(([value, stat]) => ({ value, ...stat }))
  .sort((a, b) => b.count - a.count || a.label.localeCompare(b.label));

const backArrowPath = 'M17 10H4M9 5l-5 5 5 5';
---

<Layout
  title="Project Archive — Krishna Subedi"
  description="Every project I've designed and built, in one place."
>
  <main id="content" class="archive-main" data-filter-scope>
    <a href="/" class="back-link">
      <svg viewBox="0 0 20 20" fill="none" aria-hidden="true">
        <path
          d={backArrowPath}
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      </svg>
      Krishna Subedi
    </a>
    <h1 class="archive-title">All Projects</h1>
    <FilterBar
      label="Filter projects by domain"
      param="domain"
      options={domainOptions}
      total={projects.length}
      itemLabel="projects"
    />
    <div class="table-scroll">
      <table class="archive-table">
        <caption class="sr-only">Complete archive of all projects</caption>
        <thead>
          <tr>
            <th scope="col">Year</th>
            <th scope="col">Project</th>
            <th scope="col" class="col-hide-sm">Made at</th>
            <th scope="col" class="col-hide-md">Built with</th>
            <th scope="col">Link</th>
          </tr>
        </thead>
        <tbody>
          {
            sorted.map((project) => (
              <tr data-filter-target data-filter-value={project.domains.map(slugify).join(' ')}>
                <td class="t-year">{project.year}</td>
                <th scope="row" class="t-project">
                  {project.title}
                </th>
                <td class="col-hide-sm t-madeat">
                  {project.madeAt ?? <span class="t-empty">—</span>}
                </td>
                <td class="col-hide-md">
                  <ul class="pills pills--table" aria-label={`Technologies used in ${project.title}`}>
                    {project.tech.map((t) => (
                      <li>
                        <span class="pill">{t}</span>
                      </li>
                    ))}
                  </ul>
                </td>
                <td class="t-link">
                  {availableLinks(project).length === 0 ? (
                    <span class="t-empty">
                      <span aria-hidden="true">—</span>
                      <span class="sr-only">No link available</span>
                    </span>
                  ) : (
                    <ProjectLinkIcons project={project} />
                  )}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <Footer />
  </main>
</Layout>
