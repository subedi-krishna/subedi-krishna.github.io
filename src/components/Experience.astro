---
import experience from '../../data/experience.json';
import profile from '../../data/profile.json';

const arrowPath = 'M6 14 L14 6 M9 6 H14 V11';

// Soft delete for Experience tech pills: flip this one variable to true
// and they come back. data/experience.json tech arrays stay untouched.
// When false, the <ul> is not rendered at all, so it takes no space —
// no 0.5rem pill margin, no empty list, no gap after the last bullet.
const SHOW_EXPERIENCE_TECH = false;

// Stepped-pixel arrow (original, 9x9 grid): a solid triangle pointing right,
// widest on the centre row and narrowing by steps above and below, so the
// diagonal reads as stairs rather than a smooth line. Integer coordinates
// plus crispEdges keep it blocky at any size.
const pixelArrowPath =
  'M0 0h1v1h2v1h2v1h2v1h2v1H7v1H5v1H3v1H1v1H0z';
---

<section id="experience" class="section" aria-label="Work experience">
  <div class="section-head">
    <h2>Experience</h2>
  </div>
  <div>
    <ol class="card-list">
      {
        experience.map((job) => (
          <li>
            <div class="card card--experience">
              <div class="card-body">
                <h3 class="job-title">
                  {job.title}{' '}
                  <span class="job-at" aria-hidden="true">@</span>{' '}
                  {job.companyUrl && job.companyUrl !== '#' ? (
                    <a class="company-link" href={job.companyUrl} aria-label={`${job.title} at ${job.company} (opens in a new tab)`} target="_blank" rel="noreferrer noopener">
                      {job.company}
                    </a>
                  ) : (
                    <span class="company-plain">{job.company}</span>
                  )}
                </h3>
                <p class="job-date" aria-label={job.date}>
                  {job.date}
                </p>
                <ul class="exp-points">
                  {job.points.map((point) => (
                    <li>
                      <svg class="exp-arrow" viewBox="0 0 9 9" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true">
                        <path d={pixelArrowPath} />
                      </svg>
                      <span>{point}</span>
                    </li>
                  ))}
                </ul>
                {SHOW_EXPERIENCE_TECH && (
                  <ul class="pills" aria-label="Technologies used">
                    {job.tech.map((t) => (
                      <li>
                        <span class="pill">{t}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
    {profile.resumeUrl && profile.resumeUrl !== '#' && (
      <div>
        <a
          class="more-link"
          href={profile.resumeUrl.startsWith('/')
            ? `${import.meta.env.BASE_URL.replace(/\/$/, '')}${profile.resumeUrl}`
            : profile.resumeUrl}
          aria-label="View full résumé (opens in a new tab)"
          target="_blank"
          rel="noreferrer noopener"
        >
          <span>
            View Full Résumé
            <svg class="arrow-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={arrowPath} />
            </svg>
          </span>
        </a>
      </div>
    )}
  </div>
</section>
