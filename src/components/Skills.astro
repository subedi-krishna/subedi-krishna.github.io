---
import skills from '../../data/skills.json';

// `core` (optional per category) names the skills that carry the most weight.
// Core pills keep the full teal treatment and lead the row; everything else
// renders quieter. When `core` is absent, all items render as core.
const isCore = (group: { core?: string[] }, item: string) =>
  (group.core ?? []).length === 0 || (group.core ?? []).includes(item);
---

<section id="skills" class="section" aria-label="Skills">
  <div class="section-head">
    <h2>Skills</h2>
  </div>
  <div>
    {
      skills.map((group) => {
        const coreItems = group.items.filter((item) => isCore(group, item));
        const otherItems = group.items.filter((item) => !isCore(group, item));
        return (
          <div class="skill-group">
            <h3>{group.category}</h3>
            <ul class="pills" aria-label={`${group.category} skills`}>
              {[...coreItems, ...otherItems].map((item) => (
                <li>
                  <span class={isCore(group, item) ? 'pill' : 'pill pill--secondary'}>
                    {item}
                  </span>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </div>
</section>
