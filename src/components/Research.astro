---
import research from '../../data/research.json';

// Home shows a limited set; the archive link always appears so /research is reachable.
const LIMIT = 5;
const visiblePapers = research.slice(0, LIMIT);
const showArchiveLink = research.length > 0;

const arrowPath = 'M4 16 L16 4 M8 4 H16 V12';
const rightArrowPath = 'M3 10h13M11 5l5 5-5 5';
---

<section id="research" class="section" aria-label="Research">
  <div class="section-head">
    <h2>Research</h2>
  </div>
  <div>
    <ol class="card-list">
      {
        visiblePapers.map((paper) => (
          <li>
            <div class="card">
              <header class="card-date" aria-label={paper.year}>
                {paper.year}
              </header>
              <div class="card-body">
                <h3 class="card-title">
                  {paper.venueUrl && paper.venueUrl !== '#' ? (
                    <a href={paper.venueUrl} aria-label={`${paper.title} (opens in a new tab)`} target="_blank" rel="noreferrer noopener">
                      <span>
                        {paper.title}
                        <svg class="arrow-icon" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d={arrowPath} />
                        </svg>
                      </span>
                    </a>
                  ) : (
                    <span>{paper.title}</span>
                  )}
                </h3>
                <p class="card-desc">
                  <span class="venue">{paper.venue}.</span> {paper.description}
                </p>
                <ul class="pills" aria-label="Research topics">
                  {paper.tags.map((t) => (
                    <li>
                      <span class="pill">{t}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
  {
    showArchiveLink && (
      <a class="archive-link" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/research`}>
        <span>View Full Research Archive</span>
        <svg class="arrow-right" viewBox="0 0 20 20" fill="none" aria-hidden="true">
          <path
            d={rightArrowPath}
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    )
  }
</section>
