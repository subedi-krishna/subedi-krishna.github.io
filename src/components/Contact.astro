---
import contact from '../../data/contact.json';
import profile from '../../data/profile.json';
---

<section id="contact" class="section" aria-label="Contact">
  <div class="section-head">
    <h2>Contact</h2>
  </div>
  <div class="contact">
    <p class="contact-eyebrow">{contact.eyebrow}</p>
    <h2 class="contact-title">{contact.title}</h2>
    <p class="contact-desc">{contact.description}</p>
    <a class="contact-btn" href={`mailto:${profile.email}`}>
      {contact.buttonLabel}
    </a>
  </div>
</section>
