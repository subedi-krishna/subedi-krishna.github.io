---
import '../styles/global.css';
import profile from '../../data/profile.json';

interface Props {
  title?: string;
  description?: string;
}

const { title = `${profile.name} — ${profile.title}`, description = profile.tagline } = Astro.props;

// Absolute URLs for social previews and canonical links. Astro.site comes from
// astro.config.mjs — replace the placeholder domain there before handover.
const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImageUrl = Astro.site ? new URL('/og-image.png', Astro.site).href : '/og-image.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0f172a" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#content" class="skip-link">Skip to Content</a>
    <div class="spotlight" id="spotlight" aria-hidden="true"></div>
    <div class="page">
      <div class="layout">
        <slot />
      </div>
    </div>
    <script>
      // Mouse-follow spotlight
      const spotlight = document.getElementById('spotlight');
      if (spotlight && window.matchMedia('(pointer: fine)').matches) {
        let raf = 0;
        let x = window.innerWidth / 2;
        let y = -100;
        const render = () => {
          spotlight.style.setProperty('--mx', `${x}px`);
          spotlight.style.setProperty('--my', `${y}px`);
          raf = 0;
        };
        window.addEventListener(
          'mousemove',
          (e) => {
            x = e.clientX;
            y = e.clientY;
            if (!raf) raf = requestAnimationFrame(render);
          },
          { passive: true }
        );
      }

      // Scroll-spy for the in-page nav
      const navLinks = Array.from(document.querySelectorAll('.nav-link'));
      const sections = Array.from(document.querySelectorAll('main section[id]'));
      if ('IntersectionObserver' in window && navLinks.length && sections.length) {
        const setActive = (id) => {
          navLinks.forEach((link) => {
            const isActive = link.getAttribute('href') === `#${id}`;
            link.classList.toggle('active', isActive);
            if (isActive) {
              link.setAttribute('aria-current', 'true');
            } else {
              link.removeAttribute('aria-current');
            }
          });
        };
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) setActive(entry.target.id);
            });
          },
          { rootMargin: '-35% 0px -60% 0px', threshold: 0 }
        );
        sections.forEach((s) => observer.observe(s));
      }

      // Single-select filter bars (archive pages). Progressive enhancement:
      // the bar stays hidden until this runs; without JS every row remains visible.
      // The static pages render unfiltered, so the script reads the query string
      // itself, applies the filter, syncs the URL on change, and handles
      // back/forward navigation.
      document.querySelectorAll('[data-filter-bar]').forEach((bar) => {
        const param = bar.dataset.filterParam || 'filter';
        const scope = bar.closest('[data-filter-scope]') || document;
        const targets = Array.from(scope.querySelectorAll('[data-filter-target]'));
        const buttons = Array.from(bar.querySelectorAll('[data-filter-value]'));
        const countEl = bar.querySelector('[data-filter-count]');
        const total = countEl ? Number(countEl.dataset.countTotal || targets.length) : targets.length;
        const itemLabel = (countEl && countEl.dataset.countItem) || 'items';
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Static pages render unfiltered; the query string is read client-side.
        const fromUrl = new URLSearchParams(window.location.search).get(param);
        let active =
          fromUrl && buttons.some((b) => b.dataset.filterValue === fromUrl) ? fromUrl : 'all';

        const renderCount = (value, shown) => {
          if (!countEl) return;
          countEl.textContent =
            value === 'all'
              ? `Showing ${total} ${itemLabel}`
              : `Showing ${shown} of ${total} ${itemLabel}`;
        };

        const apply = (value, push) => {
          let shown = 0;
          targets.forEach((t) => {
            const values = (t.dataset.filterValue || '').split(' ').filter(Boolean);
            const match = value === 'all' || values.includes(value);
            t.classList.toggle('is-hidden', !match);
            if (match) {
              shown += 1;
              if (!reduceMotion) {
                t.classList.remove('row-in');
                void t.offsetWidth;
                t.classList.add('row-in');
              }
            } else {
              t.classList.remove('row-in');
            }
          });
          buttons.forEach((b) =>
            b.setAttribute('aria-pressed', String(b.dataset.filterValue === value))
          );
          renderCount(value, shown);
          if (push) {
            const url = new URL(window.location.href);
            if (value === 'all') url.searchParams.delete(param);
            else url.searchParams.set(param, value);
            window.history.pushState({}, '', url);
          }
        };

        buttons.forEach((b) => {
          b.addEventListener('click', () => {
            const next = b.dataset.filterValue === active ? 'all' : b.dataset.filterValue || 'all';
            active = next;
            apply(next, true);
          });
        });

        window.addEventListener('popstate', () => {
          const fromUrl = new URL(window.location.href).searchParams.get(param) || 'all';
          active = buttons.some((b) => b.dataset.filterValue === fromUrl) ? fromUrl : 'all';
          apply(active, false);
        });

        // Apply a shared/bookmarked filter before the bar becomes visible.
        if (active !== 'all') apply(active, false);

        bar.hidden = false;
      });
    </script>
  </body>
</html>
